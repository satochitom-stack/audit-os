{
  "name": "audit-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "verify:guardrails": "node scripts/verify-guardrails.cjs",
    "test": "node tests/followup-sync.test.js && node tests/meeting-sync.test.js && node tests/strategic-plan-sync.test.js && node tests/risk-feedback-sync.test.js && node tests/tenant-isolation.test.js",
    "test:followup": "node tests/followup-sync.test.js",
    "test:meetings": "node tests/meeting-sync.test.js",
    "test:strategic": "node tests/strategic-plan-sync.test.js",
    "test:risk-feedback": "node tests/risk-feedback-sync.test.js",
    "test:isolation": "node tests/tenant-isolation.test.js",
    "build": "node scripts/verify-guardrails.cjs && vite build",
    "deploy": "node scripts/verify-guardrails.cjs && vite build && firebase deploy --only hosting",
    "lint": "oxlint",
    "test:rules": "mocha tests/security-rules.test.js --timeout 15000",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^2.0.55",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "framer-motion": "^13.4.0",
    "html2canvas-pro": "^2.5.2",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.1",
    "mocha": "^11.7.5",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
